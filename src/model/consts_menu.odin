package model

// Value fill menu additions:
//   Constant -> "win." -> MB_... -> MB_OK         inserts  win.MB_OK
//   Operator -> Bitwise -> "a | b"                turns ● into  ● | ●
// Constants come from CORE_CONSTS (generated by tools/gen_core_procs.py). Both are
// grayed out like everything else when they can't produce the type a dot expects.

import "core:fmt"
import "core:strings"

CONST_IMPORT_FILL :: "__const_import__"
OP_FILL           :: "__op__"

// All CORE_CONSTS entries for an import path, in CoreProc shape so the proc-menu
// grouping can be reused (ret = the constant's kind). Caller deletes the slice.
consts_info_for_path :: proc(path: string) -> []CoreProc {
	result: [dynamic]CoreProc
	for c in CORE_CONSTS do if c.path == path do append(&result, CoreProc{path = c.path, file = c.file, name = c.name, ret = c.kind})
	return result[:]
}

// The constants of one import: used-in-this-file first, then grouped by file and
// name prefix (MB_..., WM_...). Returns nil if the package has none.
build_import_const_menu :: proc(app: ^App, ref, path: string) -> []Entry {
	all := consts_info_for_path(path)
	defer delete(all)
	if len(all) == 0 do return nil

	used := collect_used_names(app, ref, all)
	used_set := make(map[string]bool, len(used), context.temp_allocator)
	for u in used do used_set[u] = true
	used_info := make([dynamic]CoreProc, 0, len(used), context.temp_allocator)
	for c in all do if c.name in used_set do append(&used_info, c)

	// All the constants grouped (the same groups in every project), minus the used ones.
	grouped := remove_named_leaves(build_proc_hierarchy(ref, all), used_set)
	defer delete(grouped) // entries are moved into `result`
	retarget_leaves(grouped, CONST_IMPORT_FILL)

	result := make([]Entry, len(used_info) + len(grouped))
	for c, i in used_info {
		result[i] = Entry{
			label = strings.clone(c.name), owned_label = true, pinned = true, // used in this file
			fill = CONST_IMPORT_FILL, call_pkg = strings.clone(ref), call_name = strings.clone(c.name),
			ret = c.ret, ret_pkg = c.path,
		}
	}
	copy(result[len(used_info):], grouped)
	return result
}

// The "Constant" submenu: one group per import ("win." -> its constants).
build_const_entries :: proc(app: ^App) -> []Entry {
	out: [dynamic]Entry
	defer delete(out)
	imports := collect_imports(app)
	defer delete(imports)
	for imp in imports {
		children := build_import_const_menu(app, imp.ref, imp.path)
		if children == nil do continue
		append(&out, Entry{label = fmt.aprintf("%s.", imp.ref), owned_label = true, heat_key = strings.clone(imp.path), children = children})
	}
	if len(out) == 0 do append(&out, grp_dim("(no imported constants)"))
	result := make([]Entry, len(out))
	copy(result, out[:])
	return result
}

// ---- Operators ----

Op_Class :: enum { Bitwise, Shift, Arith, Modulo, Compare, Logic, Choose }

@(private = "file")
Op_Info :: struct { label, op: string, class: Op_Class, unary: bool }

@(private = "file")
OPERATORS := [?]Op_Info{
	{"a | b", "|", .Bitwise, false}, {"a & b", "&", .Bitwise, false}, {"a ~ b  (xor)", "~", .Bitwise, false},
	{"a &~ b", "&~", .Bitwise, false}, {"~a", "~", .Bitwise, true},
	{"a << b", "<<", .Shift, false}, {"a >> b", ">>", .Shift, false},
	{"a + b", "+", .Arith, false}, {"a - b", "-", .Arith, false}, {"a * b", "*", .Arith, false},
	{"a / b", "/", .Arith, false}, {"a % b", "%", .Modulo, false}, {"-a", "-", .Arith, true},
	{"a == b", "==", .Compare, false}, {"a != b", "!=", .Compare, false},
	{"a < b", "<", .Compare, false}, {"a <= b", "<=", .Compare, false},
	{"a > b", ">", .Compare, false}, {"a >= b", ">=", .Compare, false},
	{"a && b", "&&", .Logic, false}, {"a || b", "||", .Logic, false}, {"!a", "!", .Logic, true},
	// Ternaries (expr.odin): `op` is the first keyword.
	{"a if c else b", "if", .Choose, false}, {"c ? a : b", "?", .Choose, false}, {"a when c else b", "when", .Choose, false},
}

@(private = "file")
op_info :: proc(label: string) -> (Op_Info, bool) {
	for o in OPERATORS do if o.label == label do return o, true
	return {}, false
}

// The "Operator" submenu, grouped: Bitwise / Arithmetic / Compare / Logic.
// Leaves: fill = OP_FILL, call_name = the leaf label (looked up in OPERATORS).
build_operator_entries :: proc() -> []Entry {
	group :: proc(classes: []Op_Class) -> []Entry {
		out: [dynamic]Entry
		defer delete(out)
		for o in OPERATORS {
			for c in classes do if o.class == c {
				append(&out, Entry{label = o.label, fill = OP_FILL, call_name = strings.clone(o.label)})
				break
			}
		}
		r := make([]Entry, len(out))
		copy(r, out[:])
		return r
	}
	return make_slice(
		grp("Bitwise", group({.Bitwise, .Shift})),
		grp("Arithmetic", group({.Arith, .Modulo})),
		grp("Compare", group({.Compare})),
		grp("Logic", group({.Logic})),
		grp("Choose", group({.Choose})), // a if c else b (expr.odin)
	)
}

// make_slot_operator replaces a value dot with `● op ●` (or `op●` for unary).
// Operand dots expect: the slot's own type for bitwise/arithmetic (UINT | UINT),
// anything for comparisons, bool for && / || / !.
make_slot_operator :: proc(app: ^App, ni, fi: int, label: string) {
	o, ok := op_info(label)
	if !ok do return
	if o.class == .Choose {
		make_slot_ternary(app, ni, fi, o.op) // ● if ● else ● (expr.odin)
		return
	}
	fields := &app.doc.nodes[ni].fields
	slot := fields[fi]
	hint, hint_pkg := slot.hint, slot.hint_pkg
	#partial switch o.class {
	case .Compare:     hint, hint_pkg = "", ""
	case .Logic:       hint, hint_pkg = "bool", ""
	}
	right_hint, right_pkg := hint, hint_pkg
	if o.class == .Shift do right_hint, right_pkg = "", "" // shift count: any integer
	ordered_remove(fields, fi)
	if o.unary {
		inject_at(fields, fi,
			Field{strings.clone(o.op), false, false, "", "", ""},
			Field{"", false, true, "value", hint, hint_pkg},
		)
		return
	}
	inject_at(fields, fi,
		Field{"", false, true, "value", hint, hint_pkg},
		Field{fmt.aprintf(" %s ", o.op), false, false, "", "", ""},
		Field{"", false, true, "value", right_hint, right_pkg},
	)
}

// set_slot_text replaces a slot with fixed text (e.g. a constant `win.MB_OK`).
set_slot_text :: proc(app: ^App, ni, fi: int, text: string) {
	f := &app.doc.nodes[ni].fields[fi]
	if len(f.text) > 0 do delete(f.text)
	f^ = Field{strings.clone(text), false, false, "", "", ""}
}

// ---- Fitting (graying out) ----

// const_fits: can a constant of `kind` (see CORE_CONSTS) fill a slot expecting `exp`?
const_fits :: proc(ctx: ^Type_Ctx, kind, pkg: string, exp: Resolved_Type) -> bool {
	switch kind {
	case "?", "":   return true
	case "#int":    return literal_fits("__lit_num__", exp.cat) // untyped ints also fit floats
	case "#float":  return exp.cat == .Float || exp.cat == .Any || exp.cat == .Unknown
	case "#string": return literal_fits("__lit_str__", exp.cat)
	case "#rune":   return literal_fits("__lit_rune__", exp.cat)
	case "#bool":   return literal_fits("__lit_true__", exp.cat)
	}
	return value_fits(resolve_type(ctx, kind, pkg), exp) // typed: same type
}

// op_fits: can `a op b` produce the type a slot expects?
op_fits :: proc(label: string, exp: Type_Cat) -> bool {
	o, ok := op_info(label)
	if !ok || exp == .Unknown || exp == .Any do return true
	switch o.class {
	case .Bitwise: return exp == .Integer || exp == .BitSet
	case .Shift:   return exp == .Integer
	case .Arith:   return exp == .Integer || exp == .Float || exp == .Rune || (o.op == "-" && !o.unary && exp == .BitSet)
	case .Modulo:  return exp == .Integer
	case .Compare, .Logic: return exp == .Bool
	case .Choose:          return true // both branches are the dot's type
	}
	return true
}
