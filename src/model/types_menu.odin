package model

// The "Type" fill menu: one group per import (e.g. "win." -> HWND, LPCWSTR, RECT, ...),
// then "Composite" ([N]T, map[K]V, ...), the enclosing polymorphic struct's $T
// parameters, types declared in this document, then Odin's basic types.
// Import types come from CORE_TYPES (generated by tools/gen_core_procs.py) and use
// the same grouping as the import-procedure menu (file -> kind -> prefix/alpha).

import "core:fmt"
import "core:strings"

BASIC_TYPES := [?]string{
	"int", "i8", "i16", "i32", "i64",
	"u8", "u16", "u32", "u64", "uint", "uintptr",
	"f32", "f64",
	"bool", "string", "cstring", "rune", "byte", "rawptr",
}

// Fill marker for a type leaf from an import: inserts `<call_pkg>.<call_name>`.
TYPE_IMPORT_FILL :: "__type_import__"

// The type text a fill entry inserts: "win.HWND" for import types, else e.fill.
// Temp-allocated for import types.
fill_type_text :: proc(e: Entry) -> string {
	if e.fill == TYPE_IMPORT_FILL do return fmt.tprintf("%s.%s", e.call_pkg, e.call_name)
	return e.fill
}

// All CORE_TYPES entries for an import path, in CoreProc shape so the proc-menu
// grouping can be reused (`block` = kind). Caller deletes the slice; strings are static.
types_info_for_path :: proc(path: string) -> []CoreProc {
	result: [dynamic]CoreProc
	for t in CORE_TYPES do if t.path == path do append(&result, CoreProc{path = t.path, file = t.file, block = t.kind, name = t.name})
	return result[:]
}

// Names of `ref.Name` entries (types, constants) already used in the document, so
// they can be listed first. Returned names reference `types` (static data); the
// slice is temp-allocated.
collect_used_names :: proc(app: ^App, ref: string, types: []CoreProc) -> []string {
	used := make([dynamic]string, 0, 4, context.temp_allocator)
	prefix := strings.concatenate({ref, "."}, context.temp_allocator)
	for n in app.doc.nodes {
		txt := node_text(n, context.temp_allocator)
		for start := 0; start < len(txt); {
			i := strings.index(txt[start:], prefix)
			if i < 0 do break
			at := start + i
			// must be a whole identifier (not "xwin.Foo")
			if at > 0 && is_ident_byte(txt[at - 1]) { start = at + len(prefix); continue }
			j := at + len(prefix)
			k := j
			for k < len(txt) && is_ident_byte(txt[k]) do k += 1
			name := txt[j:k]
			for t in types {
				if t.name != name do continue
				already := false
				for u in used do if u == t.name { already = true; break }
				if !already do append(&used, t.name)
				break
			}
			start = k
		}
	}
	return used[:]
}

@(private = "file")
is_ident_byte :: proc(c: u8) -> bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

// Turn proc-call leaves (built by the shared hierarchy builders) into other leaves
// (type / constant), keeping call_pkg/call_name (the `ref.Name` to insert) and ret.
retarget_leaves :: proc(entries: []Entry, fill: string) {
	for &e in entries {
		if e.fill == "__call_import_proc__" do e.fill = fill
		retarget_leaves(e.children, fill)
	}
}

// build_import_type_menu: the types of one import, used-in-this-file first, then grouped.
// Returns nil if the package has no known types. Caller owns the result (free_entries).
build_import_type_menu :: proc(app: ^App, ref, path: string) -> []Entry {
	all := types_info_for_path(path)
	defer delete(all)
	if len(all) == 0 do return nil

	used := collect_used_names(app, ref, all)
	used_set := make(map[string]bool, len(used), context.temp_allocator)
	for u in used do used_set[u] = true

	// All the types grouped (the same groups in every project), minus the used ones.
	grouped := remove_named_leaves(build_proc_hierarchy(ref, all), used_set)
	defer delete(grouped) // entries are moved into `result`
	retarget_leaves(grouped, TYPE_IMPORT_FILL)

	result := make([]Entry, len(used) + len(grouped))
	for u, i in used {
		result[i] = Entry{
			label = strings.clone(u), owned_label = true, pinned = true, // used in this file
			fill = TYPE_IMPORT_FILL, call_pkg = strings.clone(ref), call_name = strings.clone(u),
		}
	}
	copy(result[len(used):], grouped)
	return result
}

// build_type_entries is the content of every "Type" menu (type slots, the Type
// submenu of value slots, and LT+A edit). Caller owns the result (free_entries).
build_type_entries :: proc(app: ^App) -> []Entry {
	out: [dynamic]Entry
	defer delete(out)

	// Types from imports first: "win." -> its types.
	imports := collect_imports(app)
	defer delete(imports)
	for imp in imports {
		children := build_import_type_menu(app, imp.ref, imp.path)
		if children == nil do continue
		append(&out, Entry{
			label = fmt.aprintf("%s.", imp.ref), owned_label = true,
			heat_key = strings.clone(imp.path), // heat is shared across aliases (heat.odin)
			children = children,
		})
	}

	// Built from other types: [N]T, []T, [dynamic]T, map[K]V, ^T, [^]T (data_types.odin).
	append(&out, composite_type_group())

	// Inside a polymorphic struct: its own parameters ($T -> T).
	for t in poly_params_in_scope(app, app.slot_ni) do append(&out, fill_leaf(t, t))

	// Types declared in this document (structs, enums, aliases, ... - not constants).
	for t in doc_type_names(app) do append(&out, fill_leaf(t, t))

	// Odin basic types.
	for t in BASIC_TYPES do append(&out, fill_leaf(t, t))

	result := make([]Entry, len(out))
	copy(result, out[:])
	return result
}
